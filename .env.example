# Lodging Finder settings for local runs.
# Copy this file to .env and fill in the values. .env is ignored by git; never commit it.
# On GitHub, the same names go in Settings > Secrets and variables > Actions:
# LODGING_SOURCES as a Variable, everything else as a Secret.

# Which sources to run, comma-separated. Leave a source out to keep it off.
#   trmf           Medora Foundation booking engine (no key; see PLAN.md before turning on)
#   google_hotels  Dickinson hotels, AmericInn Medora, Trapper's Inn
#   airbnb         Airbnb rentals around Medora, plus the Boots and Crossings cabins
#   vrbo           Vrbo rentals around Medora
LODGING_SOURCES=

# SearchApi key for Google Hotels. https://www.searchapi.io > Dashboard > API key
SEARCHAPI_KEY=

# Optional, unused today: Guesty Booking Engine API credentials, if a cabin operator ever
# shares them (then add "guesty" to LODGING_SOURCES and a guesty live block in data/properties.json).
# GUESTY_CLIENT_ID=
# GUESTY_CLIENT_SECRET=

# Apify token for the Airbnb and Vrbo calendars. https://console.apify.com > Settings > API & Integrations
APIFY_TOKEN=
